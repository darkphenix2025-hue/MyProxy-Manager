{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyProxy Manager",
  "version": "4.1.31",
  "identifier": "com.myproxy.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "MyProxy Manager",
        "width": 1024,
        "height": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "process": null,
    "fs": null,
    "dialog": null,
    "opener": null,
    "single-instance": null,
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFOTgwMkUyQ0IxN0QzRDAKUldUUTB4Zkw0Z0tZL2xzc1pXbDBXL0kzMmw0STVFbzF6aHU1UzVRdldyTFhWSVJCV0xZb3RobEgK",
      "endpoints": [
        "https://github.com/darkphenix2025-hue/MyProxy-Manager/releases/latest/download/latest.json"
      ]
    }
  }
}
